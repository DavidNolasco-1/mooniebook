{
  "expo": {
    "name": "mooniebook",
    "slug": "mooniebook",
    "scheme": "mooniebook",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#192f6a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mooniebook.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#192f6a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3c22084-e3d9-4878-91e7-fecfcca8e4c0"
      }
    }
  }
}
